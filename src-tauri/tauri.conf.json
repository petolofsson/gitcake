{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-task",
  "version": "0.1.0",
  "identifier": "com.pol.git-task",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "git-task",
        "width": 320,
        "height": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "git-task",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "preferences",
        "title": "Preferences",
        "width": 480,
        "height": 360,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
